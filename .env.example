# Configure a local ROM; model fields can stay blank for --controller manual.
ROM_PATH=
GAME_DATA_PATH=data/generated.json
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_MIN_INTERVAL_MS=300
JEV_MAX_PER_MIN=90
CODEX_TIMEOUT_SECONDS=180

# Optional legacy HTTP planner: OpenRouter or another compatible endpoint.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
MODEL_TIMEOUT_SECONDS=20
